        {
          "name": "Registrar cuenta propia y solicitar código",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "description": "Operación real. Requiere allowRealWrites=true y los datos propios configurados. No se ejecuta al importar.",
            "body": {
              "mode": "raw",
              "raw": "{{requestBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.variables.get('allowRealWrites') !== 'true') { pm.execution.skipRequest(); throw new Error('Activa allowRealWrites solo para una operación real elegida.'); }",
                  "const fields = [\"firstName\",\"paternalLastName\",\"curp\",\"municipalityCode\",\"email\",\"password\"];",
                  "const body = {};",
                  "for (const key of fields) { const value = pm.variables.get(key); if (typeof value !== 'string' || !value.length) { pm.execution.skipRequest(); throw new Error('Falta configurar: ' + key); } body[key] = value; }",
                  "const maternal = pm.variables.get('maternalLastName'); if (typeof maternal === 'string' && maternal.trim()) body.maternalLastName = maternal;",
                  "pm.variables.set('requestBody', JSON.stringify(body));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 401) { pm.collectionVariables.set('sessionToken', ''); pm.collectionVariables.set('trackingToken', ''); }",
                  "if (pm.response.code >= 200 && pm.response.code < 300 || pm.response.code === 403) {",
                  "  const data = pm.response.json();",
                  "  if (data.token) { pm.collectionVariables.set('sessionToken', data.token); pm.collectionVariables.set('trackingToken', ''); }",
                  "  else if (pm.response.code === 403) pm.collectionVariables.set('sessionToken', '');",
                  "  if (data.verification && data.verification.trackingToken) pm.collectionVariables.set('trackingToken', data.verification.trackingToken);",
                  "  if (data.email) pm.collectionVariables.set('email', data.email);",
                  "}"
                ]
              }
            }
          ]
