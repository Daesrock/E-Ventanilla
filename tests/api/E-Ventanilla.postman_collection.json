    {
      "name": "Sesión y seguimiento",
      "item": [
        {
          "name": "Iniciar sesión (no envía correo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "Ejecuta solo esta solicitud al pulsar Send.",
            "body": {
              "mode": "raw",
              "raw": "{{requestBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const fields = [\"identifier\",\"password\"];",
                  "const body = {};",
                  "for (const key of fields) { const value = pm.variables.get(key); if (typeof value !== 'string' || !value.length) { pm.execution.skipRequest(); throw new Error('Falta configurar: ' + key); } body[key] = value; }",
                  "Object.assign(body, {\"allowPendingVerification\":true});",
                  "pm.variables.set('requestBody', JSON.stringify(body));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 401) { pm.collectionVariables.set('sessionToken', ''); pm.collectionVariables.set('trackingToken', ''); }",
                  "if (pm.response.code >= 200 && pm.response.code < 300 || pm.response.code === 403) {",
                  "  const data = pm.response.json();",
                  "  if (data.token) { pm.collectionVariables.set('sessionToken', data.token); pm.collectionVariables.set('trackingToken', ''); }",
                  "  else if (pm.response.code === 403) pm.collectionVariables.set('sessionToken', '');",
                  "  if (data.verification && data.verification.trackingToken) pm.collectionVariables.set('trackingToken', data.verification.trackingToken);",
                  "  if (data.email) pm.collectionVariables.set('email', data.email);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Mi perfil",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sessionToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me",
            "description": "Ejecuta solo esta solicitud al pulsar Send."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get('sessionToken')) { pm.execution.skipRequest(); throw new Error('Falta sessionToken: inicia sesión o retoma seguimiento primero.'); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Retomar seguimiento sin envío",
