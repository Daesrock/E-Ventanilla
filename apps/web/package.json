{
  "name": "@e-ventanilla/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Prototipo administrativo institucional. Documentación de este archivo: docs/file-map.md.",
  "scripts": {
    "dev": "concurrently -k -n web,bff -c cyan,green \"vite --host 127.0.0.1\" \"tsx watch server/index.ts\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node tools/check-docs.mjs",
    "check:api": "tsx tools/check-api.ts",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "sharp": "^0.35.5",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
