# Configuración del servidor. Nunca copiar estas variables a Android.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
POSTGRES_USER=eventanilla
POSTGRES_DB=eventanilla
POSTGRES_PASSWORD=
DATABASE_URL=
# En Docker usar *_FILE con secretos montados, sin definir también la variable directa.
# DATABASE_URL_FILE=/run/secrets/api_database_url
# AUTH_CODE_SECRET_FILE=/run/secrets/auth_code_secret
# RESEND_API_KEY_FILE=/run/secrets/resend_api_key
# RESEND_FROM_FILE=/run/secrets/resend_from
# Solo la IP exacta del Nginx del VPS; vacío en desarrollo local.
TRUSTED_PROXY_IPS=
# Configura la clave de tu cuenta en apps/api/.env, no en este archivo.
RESEND_API_KEY=
# Dirección de envío de un dominio verificado en Resend.
RESEND_FROM=
# Se genera localmente; protege los códigos frente a búsquedas por fuerza bruta.
AUTH_CODE_SECRET=
# Parámetros técnicos de seguridad; no son reglas de citas institucionales.
AUTH_CODE_TTL_SECONDS=600
AUTH_CODE_ATTEMPTS=5
AUTH_CODE_RESEND_SECONDS=60
AUTH_SESSION_TTL_SECONDS=604800
# Vacío mantiene la selección manual. En Docker, el servicio es privado y no usa claves.
OSRM_BASE_URL=
