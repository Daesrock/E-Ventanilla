root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space

[*.{ts,mjs,json,yaml,yml}]
indent_size = 2

[*.{kt,kts}]
indent_size = 4
ktlint_code_style = android_studio
ktlint_function_naming_ignore_when_annotated_with = Composable
ij_kotlin_packages_to_use_import_on_demand = androidx.compose.**,dev.daesrock.eventanilla.**,org.junit.Assert
max_line_length = 140
